    "WssPort": 1994, //ws加密端口
    //"CertificatePath": "F://ssl证书/yapi.lightcastle.cn.pfx", //证书文件路径
    "CertificatePath": "E://ssl/mqttservr.pfx", //证书文件路径
    "CertificatePassword": "kw123456", // 证书文件密匙
